{
    "layer": "top",
    "position": "top",
    "height": 27,
    "spacing": 0,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["custom/clock", "privacy"],
    "modules-right": ["idle_inhibitor", "cpu", "memory", "backlight", "wireplumber", "battery", "tray", "custom/wallpaper", "custom/power"],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
        //"persistent-workspaces": {
        //    "*": [1, 2, 3, 4, 5]
        //}
    },

    "hyprland/window": {
        "format": "{}"
    },

    "custom/clock": {
    		"exec": "date +'%I:%M %p %A, %b %d' | awk '{print tolower($0)}'",
    		"interval": 10,
    		"format": "<span color='#cec2db'> {}</span>"
	},

    "privacy": {
    	"icon-spacing": 4,
    	"icon-size": 15,
    	"transition-duration": 250,
    	"modules": [
    		{
    			"type": "screenshare",
    			"tooltip": true,
    			"tooltip-icon-size": 24
    		},
    		{
    			"type": "audio-out",
    			"tooltip": true,
    			"tooltip-icon-size": 24
    		},
    		{
    			"type": "audio-in",
    			"tooltip": true,
    			"tooltip-icon-size": 24
    		},
    		{
    			"type": "location",
    			"icon-name": "location-services-active-symbolic"
    		}
    	],
    	"ignore-monitor": true
    },

    "wireplumber": {
        "format": "<span color='#49454e'>| </span><span color='#cec2db'>volume</span> <span color='#958e99'>{volume}%</span>",
        "on-click": "pavucontrol"

    },

    "idle_inhibitor": {
        "format": "<span color='#49454e'></span><span color='#cec2db'>sleep</span> <span color='#958e99'>{icon}</span>",
	    "format-icons": {
		    "activated": "off",
		    "deactivated": "on"
	    }
    },

    "cpu": {
        "interval": 10,
        "format": "<span color='#49454e'>| </span><span color='#cec2db'>cpu</span> <span color='#958e99'>{usage}%</span>"

    },

    "memory": {
        "interval": 10,
        "format": "<span color='#49454e'>| </span><span color='#cec2db'>memory</span> <span color='#958e99'>{}%</span>"

    },

    "battery": {
        "format": "<span color='#49454e'>| </span><span color='#cec2db'>battery</span> <span color='#958e99'>{capacity}%</span>",
        "format-charging": "<span color='#49454e'>| </span><span color='#cec2db'>ac:</span> <span color='#958e99'>{capacity}%</span>",
        "states": {
        "critical": 15
    	},
    	"tooltip": false,
    	"interval": 20

    },

    "backlight": {
        "format": "<span color='#49454e'>| </span><span color='#cec2db'>light</span> <span color='#958e99'>{percent}%</span>",
        "tooltip": false
    },

    "tray": {
        "icon-size": 17,
        "spacing": 10
    },

    "custom/wallpaper": {
		"format": " ",
		"on-click": "exec ~/.config/waybar/scripts/wall.sh",
		"on-click-right": "exec ~/.config/waybar/scripts/wallpaper.sh",
        "on-click-middle": "exec ~/.config/waybar/scripts/highQualityWallpaper.sh",
		"tooltip-format": "Custom script to change the wallpaper"
	},

    "custom/power": {
        "format":"⏻",
        "on-click": "exec ~/.config/waybar/scripts/power_menu.sh",
        "tooltip": false
    }

}
